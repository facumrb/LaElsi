# --- Dependencias ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Variables de Entorno ---
.env
.env.*
!.env.example

# --- Supabase CLI (archivos locales que genera al vincular el proyecto) ---
supabase/.temp/
supabase/.branches/

# --- Builds y Salidas de Compilación (Aplica a BE y FE) ---
dist/
build/
out/
tmp/
*.tsbuildinfo
tsconfig.tsbuildinfo

# Ignorar subidas de imágenes
uploads/*
!uploads/.gitkeep

# --- Frameworks Específicos (Angular, Sass, etc.) ---
**/.angular/
.sass-cache/
connect.lock
typings/
libpeerconnection.log
testem.log

# --- Sistema Operativo ---
.DS_Store
Thumbs.db

# --- IDEs y Editores (General) ---
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project

# --- Visual Studio Code ---
# Ignorar todo dentro de .vscode por defecto...
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Ignorar historial local y extensiones empaquetadas
.history/
*.vsix

# --- AI Agents & Graphify ---
graphify-out/
.agents/local/
.agents/cache/
.claude/settings.local.json
.specify/local/
docs/Datos de despliegue.md
