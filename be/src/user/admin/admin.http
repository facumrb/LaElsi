# La contraseña de prueba no se versiona: se lee de la variable de entorno SEED_PASSWORD
# (definila en tu sistema antes de abrir VS Code, con al menos 12 caracteres).
@password = {{$processEnv SEED_PASSWORD}}

### GET ALL Administradores
GET http://localhost:3000/api/admins

### POST Crear un Administrador
# @name createAdmin
POST http://localhost:3000/api/admins
Content-Type: application/json

{
  "name": "AdminSeguro",
  "lastName": "Prueba",
  "phone": "423423423",
  "username": "admin1",
  "password": "{{password}}",
  "email": "admin.prueba@example.com"
}

### POST Iniciar Sesión (Login)
POST http://localhost:3000/api/users/login
Content-Type: application/json

{
  "identifier": "admin1",
  "password": "{{password}}"
}

### ID del Administrador creado
@id = {{createAdmin.response.body.data.id}}

### GET Un Administrador por ID
GET http://localhost:3000/api/admins/{{id}}

### PATCH Actualizar un Administrador
PATCH http://localhost:3000/api/admins/{{id}}
Content-Type: application/json

{
  "name": "Admin Actualizado",
  "lastName": "Prueba Actualizado",
  "phone": "123456789",
  "email": "nuevo.email@example.com"
}

### DELETE Eliminar un Administrador
DELETE http://localhost:3000/api/admins/{{id}}
