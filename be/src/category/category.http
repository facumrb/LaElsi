### 1. LOGIN DE ADMIN (Creado por el Seed)
# @name loginRequest
POST http://localhost:3000/api/admins/login
Content-Type: application/json

{
  "identifier": "admin", 
  "password": "admin123"
}

### (Usa el token del paso 1 automáticamente)
@authToken = {{loginRequest.response.body.token}}


### POST (Crear Juguetería)
# @name createCategory
POST http://localhost:3000/api/categories HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "description": "Amplia variedad de juguetes y juegos educativos.",
  "state": "Inactivo",
  "name": "Juguetería"
}


### VARIABLE (Guardamos el ID, que es la nueva PK)
@categoryId = {{createCategory.response.body.data.id}}

### GET ALL
GET http://localhost:3000/api/categories HTTP/1.1

### GET ONE (Usando la variable ID)
GET http://localhost:3000/api/categories/{{categoryId}} HTTP/1.1


### PATCH (Modificar Juguetería)
PATCH http://localhost:3000/api/categories/{{categoryId}} HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "state": "Activo"
}


### POST2 (Crear Librería)
POST http://localhost:3000/api/categories HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "description": "Artículos de librería y papelería.",
  "state": "Activo",
  "name": "Librería"
}


### POST3 (Crear Computación)
POST http://localhost:3000/api/categories HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "description": "Artículos de computación e insumos.",
  "state": "Activo",
  "name": "Computacion"
}


### POST Category TO DELETE (Crea Cotillón para borrarlo luego)
# @name createCategoryToDelete
POST http://localhost:3000/api/categories HTTP/1.1
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "description": "Artículos festivos y decorativos.",
  "state": "Activo",
  "name": "Cotillon" 
}


### DELETE (Borrar Cotillón automáticamente)
@idToDelete = {{createCategoryToDelete.response.body.data.id}}
DELETE http://localhost:3000/api/categories/{{idToDelete}} HTTP/1.1
Authorization: Bearer {{authToken}}


### SEARCH
GET http://localhost:3000/api/categories/search?query=Librería HTTP/1.1